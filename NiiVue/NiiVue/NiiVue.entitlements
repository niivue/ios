<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Mac Catalyst only. UIDocumentPickerViewController is backed by NSOpenPanel
	     when importing and NSSavePanel when exporting (DocumentExporter), and the
	     sandbox denies both without this. read-WRITE, not read-only: the export
	     path writes to a location the user chooses, which read-only does not
	     cover. Unused on iOS, where the picker brokers access itself. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
